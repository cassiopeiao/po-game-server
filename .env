# THIS IS A SAMPLE ENV CONFIGURATION FILE, CHANGE IT'S NAME TO .env FOR CHANGES TO TAKE EFFECT

# ----------------------
#      Game Server
# ----------------------
# the port of the game server, the default is 2567 (set by colyseus)
PORT=2567

# uncomment this if you want to enable the server stats via the website
STATS_ENABLED=true

# uncomment this to disable the ip limit for joining
DISABLE_IP_LOCK=true

